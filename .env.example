# ===================================================================
# Match de Currículo ATS - Variáveis de Ambiente (.env.example)
# ===================================================================

# Chave de API da LLM (Google Gemini API)
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Porta local do servidor (Padrão: 3000)
PORT=3000

# Domínios permitidos no CORS (separados por vírgula)
# Deixe em branco ou '*' para permitir todas as origens em desenvolvimento
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,https://seu-dominio.vercel.app

# Ambiente de Execução (development | production)
NODE_ENV=production
